print("=== IMPORT ===");
import "mathe.nexa";
print(verdopple(21));

print("=== POWER ===");
print(2 ** 10);
print(2 ^ 8);

print("=== TRY/CATCH ===");
try {
    print(10 / 0);
} catch (fehler) {
    print("Fehler gefangen: " + fehler);
}
print("Weiter geht es");

print("=== STRUCT ===");
struct Koordinate {
    int x;
    int y;
}

var punkt = new Koordinate(5, 7);
print(punkt.x);
print(punkt.y);

print("=== CLASS ===");
class Animal {
    string name;
    int age;

    constructor(name, age) {
        this.name = name;
        this.age = age;
    }

    method speak() {
        return this.name + " ist " + this.age + " Jahre alt";
    }
}

var hund = new Animal("Rex", 5);
print(hund.name);
print(hund.age);
print(hund.speak());
hund.age = 6;
print(hund.speak());

print("=== LOOP ===");
var summe = 0;
for (int i = 0; i < 5; i++) {
    summe += i;
}
print(summe);

print("=== WHILE ===");
var z = 3;
while (z > 0) {
    z--;
}
print(z);

print("=== ARRAYS ===");
var liste = [1, 2, 3, 4];
push(liste, 5);
print(liste);
print(length(liste));
print(liste[2]);

print("=== FUNKTIONEN ===");
function fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}
print(fibonacci(10));

print("=== VERERBUNG ===");
class Lebewesen {
    string name;

    constructor(name) {
        this.name = name;
    }

    method beschreibung() {
        return "Lebewesen: " + this.name;
    }
}

class Hund extends Lebewesen {
    int beine;

    constructor(name, beine) {
        this.name = name;
        this.beine = beine;
    }

    method beschreibung() {
        return "Hund " + this.name + " mit " + this.beine + " Beinen";
    }
}

var rex = new Hund("Rex", 4);
print(rex.name);
print(rex.beine);
print(rex.beschreibung());