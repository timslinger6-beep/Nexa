// ==========================================
// Spiel: mein_spiel
// Steuerung: Pfeiltasten
// ==========================================

var W = 500;
var H = 700;

var player_x = W / 2;
var player_y = H - 80;
var speed = 5;

var score = 0;
var game_over = 0;

window("Spiel", W, H);

while (game_over == 0) {

    clear("#1a1a1a");

    // Steuerung
    if (key_down("left")) {
        player_x = player_x - speed;
    }
    if (key_down("right")) {
        player_x = player_x + speed;
    }
    if (key_down("up")) {
        player_y = player_y - speed;
    }
    if (key_down("down")) {
        player_y = player_y + speed;
    }

    // Spieler zeichnen
    rect(player_x - 15, player_y - 15, 30, 30, "#4fc3f7");

    // Score
    text(10, 10, "Score: " + score, 20, "white");

    present();
    sleep(16);
}

// Game Over
clear("#1a1a1a");
text(W / 2 - 100, H / 2, "GAME OVER", 40, "red");
present();
sleep(2000);
