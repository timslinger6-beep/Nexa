{
  "name": "nexa-language",
  "displayName": "Nexa Language",
  "description": "Nexa programming language support and file icons",
  "version": "0.1.0",
  "publisher": "nexa",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nexa",
        "aliases": [
          "Nexa",
          "nexa"
        ],
        "extensions": [
          ".nexa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexa",
        "scopeName": "source.nexa",
        "path": "./syntaxes/nexa.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nexa-icons",
        "label": "Nexa Icons",
        "path": "./nexa-icon-theme.json"
      }
    ]
  }
}
